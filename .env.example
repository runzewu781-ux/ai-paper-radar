# Hugging Face read-only token (for Papers API)
HF_TOKEN=

# GitHub fine-grained PAT (public repo read-only)
GITHUB_TOKEN=

# Semantic Scholar API key (optional, anonymous fallback with rate limits)
S2_API_KEY=

# Database URL (local: sqlite:///./data/paper_radar.db ; cloud: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=sqlite:///./data/paper_radar.db

# LLM translation (title + abstract -> Chinese)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Local proxy for Hugging Face only (leave empty on cloud / when direct connection works)
HF_PROXY=

# In-process scheduler (set false on serverless/cloud; drive sync via external cron hitting /api/sync/arxiv)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60

# CORS allowed origins (comma-separated). Add your Vercel URL here, e.g. https://xxx.vercel.app
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
